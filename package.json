{
  "name": "waldorf-community-task-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "check:toolchain": "node scripts/validate-toolchain.mjs",
    "preinstall": "npm run check:toolchain",
    "predev": "npm run check:toolchain && node --experimental-strip-types scripts/validate-runtime-config.ts development",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run check:toolchain && node --experimental-strip-types scripts/validate-runtime-config.ts production",
    "build": "next build",
    "prestart": "npm run check:toolchain && node --experimental-strip-types scripts/validate-runtime-config.ts production",
    "start": "next start --hostname ${APP_HOST:-127.0.0.1} --port ${APP_PORT:-3000}",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint app src/application src/runtime tests scripts *.config.* proxy.ts --max-warnings=0",
    "format": "prettier --write app src/application src/runtime tests scripts verification *.config.* next-env.d.ts README.md",
    "format:check": "prettier --check app src/application src/runtime tests scripts verification *.config.* next-env.d.ts README.md",
    "test:domain": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:delivery": "vitest run --config vitest.config.ts",
    "test:database:roles": "node --experimental-strip-types --test tests/database/current-role-migration.test.ts",
    "test": "npm run test:domain && npm run test:delivery",
    "test:coverage:domain": "node --experimental-strip-types --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test \"src/**/*.test.ts\"",
    "test:coverage:delivery": "vitest run --config vitest.config.ts --coverage",
    "test:coverage": "npm run test:coverage:domain && npm run test:coverage:delivery",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:login-performance": "playwright test --config playwright.login-performance.config.ts",
    "test:a11y": "playwright test --config playwright.config.ts --grep @a11y",
    "smoke:start": "node scripts/start-smoke.mjs",
    "verify:manifests": "node --experimental-strip-types scripts/verification/validate-manifests.ts",
    "verify:evidence": "node --experimental-strip-types scripts/verification/aggregate-evidence.ts",
    "scan:privacy": "node --experimental-strip-types scripts/verification/scan-artifacts.ts privacy",
    "scan:secrets": "node --experimental-strip-types scripts/verification/scan-artifacts.ts secrets",
    "scan:sast": "node --experimental-strip-types scripts/verification/scan-artifacts.ts sast",
    "verify:no-deploy": "node --experimental-strip-types scripts/verification/scan-artifacts.ts no-deploy",
    "verify:security": "npm run scan:privacy && npm run scan:secrets && npm run scan:sast && npm run verify:no-deploy && npm audit --audit-level=high",
    "verify:local": "node --experimental-strip-types scripts/verification/run-local-verification.ts",
    "verify": "npm run verify:local"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "next": "16.3.8",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "latest",
    "eslint-config-next": "16.3.8",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}

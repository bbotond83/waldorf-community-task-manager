{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waldorf-verification-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "storyIds",
    "requirementIds",
    "matrixRows",
    "manifestVersion",
    "runtimeMode",
    "target",
    "tool",
    "toolVersion",
    "result",
    "startedAt",
    "finishedAt",
    "gitSha",
    "artifactPath"
  ],
  "properties": {
    "schemaVersion": { "const": "waldorf-evidence-v1" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "storyIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "matrixRows": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "manifestVersion": { "const": "waldorf-scenarios-v1" },
    "runtimeMode": { "enum": ["database", "linked-target"] },
    "target": { "enum": ["local", "linked-target"] },
    "tool": { "type": "string", "minLength": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "browser": { "type": "string" },
    "viewport": { "type": "string" },
    "result": { "enum": ["PASS", "FAIL", "OUTSTANDING"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactPath": { "type": "string", "minLength": 1 },
    "exitCode": { "type": "integer" },
    "durationMs": { "type": "number", "minimum": 0 }
  }
}
